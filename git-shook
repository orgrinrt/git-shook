#
# git-shook: hooks that shook on it.
#
# Git runs one program per hook event, so a tool that installs a hook replaces
# whatever was there. This puts one dispatcher at the event and gives every tool
# a place to register beside the others.
#
# POSIX sh and awk throughout, deliberately. What lives at a hook event runs on
# every commit for everybody who clones the repository, including people who
# have none of the toolchain that installed it, so it may not depend on anything
# that could be missing.

set -u

VERSION=0.1.0
DISPATCH_VERSION=1

# ---------------------------------------------------------------------------
# the dispatcher
#
# This is what goes at the hook event. It reads the entries for its own event,
# runs each with the arguments git gave, and replays git's stdin to every one of
# them, since `pre-push` and `pre-receive` hand over refs that way and only the
# first child would otherwise see them.
#
# An entry is data rather than a script: the first line is the directory to run
# in, relative to the repository root, and every line after it is one argument.
# Generating a script instead would mean quoting arguments back into shell text,
# which is the injection the argument list exists to prevent.
# ---------------------------------------------------------------------------

dispatcher_text() {
	cat <<DISPATCH
#!/bin/sh
# git-shook dispatcher v$DISPATCH_VERSION
# Generated by git-shook. Do not edit: \`git shook install\` rewrites it.
#
# Runs every entry registered for this event, in sorted order, and stops at the
# first one that fails. \`git shook list\` shows what is registered.

ev=\${0##*/}
root=\$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
d="\$root/.shook/entries/\$ev"
[ -d "\$d" ] || exit 0

tmp=\$(mktemp -d) || exit 1
trap 'rm -rf "\$tmp"' EXIT

: >"\$tmp/stdin"
[ -t 0 ] || cat >"\$tmp/stdin"
for a in "\$@"; do printf '%s\\n' "\$a"; done >"\$tmp/argv"

st=0
for e in "\$d"/*; do
	[ -f "\$e" ] || continue
	wd=\$(head -n 1 "\$e")
	tail -n +2 "\$e" >"\$tmp/entry"
	set --
	while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/entry"
	while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/argv"
	[ \$# -gt 0 ] || continue
	( cd "\$root/\$wd" 2>/dev/null || exit 127; exec "\$@" ) <"\$tmp/stdin" || { st=\$?; break; }
done
exit \$st
DISPATCH
}

# ---------------------------------------------------------------------------
# the manifest reader
#
# One awk program, two modes. It reads the subset of toml the format uses and
# refuses the rest by name, rather than accepting something it cannot render.
#
# The string walk is character by character and tracks whether it is inside a
# quote, which is the whole reason it is not a `split` on commas: an argument
# containing a comma would be torn in two and neither half would unquote.
# ---------------------------------------------------------------------------

MANIFEST_AWK='
function fail(msg) { print FILENAME ":" FNR ": " msg > "/dev/stderr"; exit 2 }

function unquote(buf,   i, c, inq, esc, cur, n) {
	inq = 0; esc = 0; cur = ""; n = 0
	for (i = 1; i <= length(buf); i++) {
		c = substr(buf, i, 1)
		if (inq) {
			if (esc) {
				if (c == "n") cur = cur "\n"
				else if (c == "t") cur = cur "\t"
				else cur = cur c
				esc = 0
			} else if (c == "\\") esc = 1
			else if (c == "\"") { out[n++] = cur; inq = 0; cur = "" }
			else cur = cur c
		} else if (c == "\"") { inq = 1; cur = "" }
		else if (c != "," && c != "[" && c != "]" && c != " " && c != "\t")
			fail("a run entry takes quoted strings only, found " c)
	}
	if (inq) fail("unterminated string")
	return n
}

function flush(   i, n) {
	if (buf == "") return
	n = unquote(buf)
	if (mode == "argv" && ev == want) for (i = 0; i < n; i++) print out[i]
	buf = ""
}

{ line = $0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line) }

collecting {
	buf = buf " " line
	if (index(line, "]")) { collecting = 0; flush() }
	next
}

line ~ /^#/ || line == "" { next }

line ~ /^\[/ {
	if (line ~ /^\[hooks\.[A-Za-z0-9_-]+\]$/) {
		ev = line
		sub(/^\[hooks\./, "", ev)
		sub(/\]$/, "", ev)
		if (mode == "events") print ev
	} else if (line ~ /^\[hooks\]$/) {
		ev = ""
	} else if (line ~ /^\[/) {
		ev = ""
	}
	next
}

line ~ /^name[ \t]*=/ {
	if (mode == "name") {
		v = line; sub(/^name[ \t]*=[ \t]*/, "", v)
		gsub(/^"|"$/, "", v)
		print v
	}
	next
}

line ~ /^run[ \t]*=/ {
	if (ev == "") fail("run outside a [hooks.<event>] section")
	buf = line
	sub(/^run[ \t]*=[ \t]*/, "", buf)
	if (index(buf, "]")) flush()
	else collecting = 1
	next
}

{ fail("unrecognised line: " line) }
'

manifest_read() { # <mode> <manifest> [event]
	awk -v mode="$1" -v want="${3:-}" "$MANIFEST_AWK" "$2"
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
	printf 'git-shook: %s\n' "$1" >&2
	exit 1
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# Every manifest in the tree, one path per line. `git ls-files` rather than
# `find`, so a manifest has to be tracked to be found: an untracked one is
# somebody's scratch file and is not something to wire into a hook.
find_manifests() { # <root>
	git -C "$1" ls-files --full-name -- 'shook.toml' '*/shook.toml' 2>/dev/null | sort
}

# The name a manifest registers under, which decides its filename in the entry
# directory and therefore where it falls in the run order.
manifest_name() { # <root> <relative manifest path>
	n=$(manifest_read name "$1/$2")
	if [ -z "$n" ]; then
		n=$(dirname "$2")
		[ "$n" = "." ] && n=$(basename "$1")
		n=$(basename "$n")
	fi
	printf '%s' "$n"
}

# Where a manifest's hooks run, relative to the repository root. Empty for one
# at the root, which is why nothing here may go through a whitespace-separated
# field: an empty value has to survive being passed around.
manifest_dir() { # <relative manifest path>
	d=$(dirname "$1")
	[ "$d" = "." ] && d=""
	printf '%s' "$d"
}

# Every event any manifest declares, once each, in the order first seen.
collect_events() { # <root> <manifests>
	evs=""
	for m in $2; do
		for ev in $(manifest_read events "$1/$m"); do
			case " $evs " in
			*" $ev "*) ;;
			*) evs="$evs $ev" ;;
			esac
		done
	done
	printf '%s' "$evs"
}

# An argument list on one line for a person to read, with anything containing a
# space quoted so two arguments never look like one. Never used to reconstruct
# a command; the entry file is the thing that runs.
show_argv() { # <newline separated argv>
	printf '%s\n' "$1" | awk '{ if ($0 ~ /[ \t]/) printf "\"%s\" ", $0; else printf "%s ", $0 } END { print "" }'
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
	yes=0
	for a in "$@"; do
		case $a in
		-y | --yes) yes=1 ;;
		-*) die "unknown flag: $a" ;;
		esac
	done

	root=$(repo_root)
	manifests=$(find_manifests "$root")
	[ -n "$manifests" ] || die "no tracked shook.toml anywhere in $root"

	# Two passes over the manifests rather than one pass into a plan file. The
	# encoding that would need is a field separator that survives an empty
	# field, and shell `read` collapses runs of whitespace, so a tab-separated
	# plan silently loses an empty working directory and shifts everything
	# after it. Reading the manifests twice costs nothing and cannot do that.
	events=$(collect_events "$root" "$manifests")

	printf 'git-shook will register:\n\n'
	for m in $manifests; do
		name=$(manifest_name "$root" "$m")
		wd=$(manifest_dir "$m")
		for ev in $(manifest_read events "$root/$m"); do
			argv=$(manifest_read argv "$root/$m" "$ev")
			[ -n "$argv" ] || die "$m: [hooks.$ev] has no run"
			printf '  %-14s %-16s %s' "$ev" "$name" "$(show_argv "$argv")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			printf '\n'
		done
	done
	printf '\n'

	if [ "$yes" -eq 0 ]; then
		[ -t 0 ] || die "not a terminal, so pass --yes to install without confirming"
		printf 'Register these and point core.hooksPath at .shook/hooks? [y/N] '
		read -r reply
		case $reply in
		y | Y | yes | YES) ;;
		*) die "nothing installed" ;;
		esac
	fi

	mkdir -p "$root/.shook/hooks" "$root/.shook/entries"

	# A hook that is already there is moved in beside the others rather than
	# replaced, so it keeps running and uninstall can put it back.
	migrate_existing "$root" "$events"

	for ev in $events; do
		mkdir -p "$root/.shook/entries/$ev"
		dispatcher_text >"$root/.shook/hooks/$ev"
		chmod +x "$root/.shook/hooks/$ev"
	done

	for m in $manifests; do
		name=$(manifest_name "$root" "$m")
		wd=$(manifest_dir "$m")
		for ev in $(manifest_read events "$root/$m"); do
			{
				printf '%s\n' "$wd"
				manifest_read argv "$root/$m" "$ev"
			} >"$root/.shook/entries/$ev/$name"
		done
	done

	git -C "$root" config core.hooksPath .shook/hooks

	printf 'Registered. core.hooksPath is .shook/hooks.\n'
	printf 'The dispatcher and the entries are files in the repository; the config line is not,\n'
	printf 'and cannot be, so everyone who clones this runs `git shook install` themselves.\n'
}

# An existing hook at an event we are about to take is moved to
# `.shook/entries/<event>/00-existing` so it still runs, first, and uninstall
# can put it back where it was.
migrate_existing() { # <root> <events>
	old=$(git -C "$1" config --get core.hooksPath || true)
	case $old in
	.shook/hooks | "") from="$1/.git/hooks" ;;
	*) from="$1/$old" ;;
	esac
	[ "$old" = ".shook/hooks" ] && return 0

	for ev in $2; do
		h="$from/$ev"
		[ -f "$h" ] || continue
		mkdir -p "$1/.shook/entries/$ev" "$1/.shook/kept"
		cp "$h" "$1/.shook/kept/$ev"
		chmod +x "$1/.shook/kept/$ev"
		{
			printf '\n'
			printf '%s\n' "sh"
			printf '%s\n' ".shook/kept/$ev"
		} >"$1/.shook/entries/$ev/00-existing"
		printf 'kept the %s hook that was already here, as 00-existing\n' "$ev"
	done
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

cmd_list() {
	root=$(repo_root)
	d="$root/.shook/entries"
	if [ ! -d "$d" ]; then
		printf 'nothing registered\n'
		return 0
	fi
	for ev in "$d"/*; do
		[ -d "$ev" ] || continue
		printf '%s\n' "${ev##*/}"
		for e in "$ev"/*; do
			[ -f "$e" ] || continue
			wd=$(head -n 1 "$e")
			printf '  %-16s %s' "${e##*/}" "$(show_argv "$(tail -n +2 "$e")")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			printf '\n'
		done
	done
	active=$(git -C "$root" config --get core.hooksPath || printf '(unset)')
	printf '\ncore.hooksPath: %s\n' "$active"
	[ "$active" = ".shook/hooks" ] || printf 'not active here: run `git shook install`\n'
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
	root=$(repo_root)
	bad=0

	active=$(git -C "$root" config --get core.hooksPath || printf '')
	if [ "$active" != ".shook/hooks" ]; then
		printf 'core.hooksPath is "%s", so nothing here runs. Run `git shook install`.\n' "$active"
		bad=1
	fi

	for m in $(find_manifests "$root"); do
		for ev in $(manifest_read events "$root/$m"); do
			name=$(manifest_name "$root" "$m")
			if [ ! -f "$root/.shook/entries/$ev/$name" ]; then
				printf '%s declares [hooks.%s] and is not registered. Run `git shook install`.\n' "$m" "$ev"
				bad=1
			fi
		done
	done

	if [ -d "$root/.shook/entries" ]; then
		for ev in "$root"/.shook/entries/*; do
			[ -d "$ev" ] || continue
			e="$root/.shook/hooks/${ev##*/}"
			if [ ! -x "$e" ]; then
				printf 'entries exist for %s with no dispatcher. Run `git shook install`.\n' "${ev##*/}"
				bad=1
			fi
		done
	fi

	[ "$bad" -eq 0 ] && printf 'all good\n'
	return $bad
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
	root=$(repo_root)
	if [ -d "$root/.shook/kept" ]; then
		for k in "$root"/.shook/kept/*; do
			[ -f "$k" ] || continue
			mkdir -p "$root/.git/hooks"
			cp "$k" "$root/.git/hooks/${k##*/}"
			chmod +x "$root/.git/hooks/${k##*/}"
			printf 'put back the %s hook that was here before\n' "${k##*/}"
		done
	fi
	git -C "$root" config --unset core.hooksPath 2>/dev/null || true
	rm -rf "$root/.shook"
	printf 'removed .shook and cleared core.hooksPath\n'
}

# ---------------------------------------------------------------------------

usage() {
	cat <<'HELPTEXT'
git-shook: hooks that shook on it.

Git runs one program per hook event, so a tool that installs a hook replaces
whatever was there. git-shook puts one dispatcher at the event and gives every
tool a place to register beside the others.

USAGE
    git shook <command>

COMMANDS
    install [--yes]   Read every tracked shook.toml, show what each would run,
                      and register it once you say so.
    list              What is registered, per event, in the order it runs.
    doctor            Whether what is declared and what is registered agree.
    uninstall         Remove the registry and put back the hook that was here.
    version           Print the version.

A shook.toml declares what its own project wants run:

    name = "ante"

    [hooks.pre-commit]
    run = ["ante", "fix"]

`run` is an argument list rather than a command line, so nothing goes through a
shell and there is no quoting to get wrong. It runs with the manifest's own
directory as its working directory. A hook that needs a pipe or a redirect ships
a script and names it, which puts it in a diff where somebody can object to it.

Discovery happens when you run `install`, never when a hook fires, so a manifest
arriving through a merge does nothing until you look at it and say yes.
HELPTEXT
}

case "${1:-}" in
install)
	shift
	cmd_install "$@"
	;;
list)
	shift
	cmd_list "$@"
	;;
doctor)
	shift
	cmd_doctor "$@"
	;;
uninstall)
	shift
	cmd_uninstall "$@"
	;;
dispatcher)
	dispatcher_text
	;;
version | --version | -V)
	printf 'git-shook %s\n' "$VERSION"
	;;
help | --help | -h | "")
	usage
	;;
*)
	die "unknown command: $1 (try \`git shook help\`)"
	;;
esac
