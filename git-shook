#
# git-shook: hooks that shook on it.
#
# Git runs one program per hook event, so a tool that installs a hook replaces
# whatever was there. This puts one dispatcher at the event and gives every tool
# a place to register beside the others.
#
# POSIX sh and awk throughout, deliberately. What lives at a hook event runs on
# every commit for everybody who clones the repository, including people who
# have none of the toolchain that installed it, so it may not depend on anything
# that could be missing.

set -u

VERSION=0.1.0
DISPATCH_VERSION=1

# ---------------------------------------------------------------------------
# the dispatcher
#
# This is what goes at the hook event. It reads the entries for its own event,
# runs each with the arguments git gave, and replays git's stdin to every one of
# them, since `pre-push` and `pre-receive` hand over refs that way and only the
# first child would otherwise see them.
#
# An entry is data rather than a script: the first line is the directory to run
# in, relative to the repository root, and every line after it is one argument.
# Generating a script instead would mean quoting arguments back into shell text,
# which is the injection the argument list exists to prevent.
# ---------------------------------------------------------------------------

dispatcher_text() {
	cat <<DISPATCH
#!/bin/sh
# git-shook dispatcher v$DISPATCH_VERSION
# Generated by git-shook. Do not edit: \`git shook install\` rewrites it.
#
# Runs every entry registered for this event, in sorted order, and stops at the
# first one that fails. \`git shook list\` shows what is registered.

# Sorted means one thing only if the collation is fixed. Without this the run
# order is the user's locale, which is not an order anybody can reason about.
LC_ALL=C
export LC_ALL

ev=\${0##*/}

# A bare repository has no work tree, so \`--show-toplevel\` fails there and the
# push hooks a bare repository exists to run would be silently inert. Fall back
# to the git directory, which is where a bare repository keeps everything.
root=\$(git rev-parse --show-toplevel 2>/dev/null) ||
	root=\$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0

# The entries live beside this script, in the git directory, and the shared one
# rather than a linked worktree's, since one \`core.hooksPath\` serves them all.
g=\$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
case \$g in
/*) ;;
*) g="\$(pwd)/\$g" ;;
esac

d="\$g/shook/entries/\$ev"
[ -d "\$d" ] || exit 0

# Anything git handed us by a path relative to the current directory has to be
# made absolute before an entry is run somewhere else, or it resolves against
# the wrong directory. \`GIT_INDEX_FILE\` is the one that bites, because a
# program that is not git itself reads it verbatim.
if [ -n "\${GIT_INDEX_FILE:-}" ]; then
	case \$GIT_INDEX_FILE in
	/*) ;;
	*)
		GIT_INDEX_FILE="\$(pwd)/\$GIT_INDEX_FILE"
		export GIT_INDEX_FILE
		;;
	esac
fi

tmp=\$(mktemp -d 2>/dev/null || mktemp -d -t git-shook) || exit 1
trap 'rm -rf "\$tmp"' EXIT

: >"\$tmp/stdin"
[ -t 0 ] || cat >"\$tmp/stdin"
for a in "\$@"; do printf '%s\\n' "\$a"; done >"\$tmp/argv"

st=0
for e in "\$d"/*; do
	[ -f "\$e" ] || continue
	wd=\$(head -n 1 "\$e")
	tail -n +2 "\$e" >"\$tmp/entry"
	set --
	while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/entry"
	while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/argv"
	[ \$# -gt 0 ] || continue
	( cd "\$root/\$wd" 2>/dev/null || exit 127; exec "\$@" ) <"\$tmp/stdin" || { st=\$?; break; }
done
exit \$st
DISPATCH
}

# ---------------------------------------------------------------------------
# the manifest reader
#
# One awk program, two modes. It reads the subset of toml the format uses and
# refuses the rest by name, rather than accepting something it cannot render.
#
# The string walk is character by character and tracks whether it is inside a
# quote, which is the whole reason it is not a `split` on commas: an argument
# containing a comma would be torn in two and neither half would unquote.
# ---------------------------------------------------------------------------

MANIFEST_AWK='
function fail(msg) { print FILENAME ":" FNR ": " msg > "/dev/stderr"; exit 2 }

function unquote(buf,   i, c, inq, esc, cur, n) {
	inq = 0; esc = 0; cur = ""; n = 0
	for (i = 1; i <= length(buf); i++) {
		c = substr(buf, i, 1)
		if (inq) {
			if (esc) {
				# An entry file is one argument per line, so an argument
				# holding a newline cannot be written down at all. Refused
				# here rather than decoded, because decoded it would become
				# two arguments and nothing downstream could tell.
				if (c == "n") fail("an argument may not contain a newline")
				else if (c == "t") cur = cur "\t"
				else cur = cur c
				esc = 0
			} else if (c == "\\") esc = 1
			else if (c == "\"") { out[n++] = cur; inq = 0; cur = "" }
			else cur = cur c
		} else if (c == "\"") { inq = 1; cur = "" }
		else if (c != "," && c != "[" && c != "]" && c != " " && c != "\t")
			fail("a run entry takes quoted strings only, found " c)
	}
	if (inq) fail("unterminated string")
	return n
}

function flush(   i, n) {
	if (buf == "") return
	n = unquote(buf)
	if (mode == "argv" && ev == want) for (i = 0; i < n; i++) print out[i]
	buf = ""
}

{ line = $0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line) }

collecting {
	buf = buf " " line
	if (index(line, "]")) { collecting = 0; flush() }
	next
}

line ~ /^#/ || line == "" { next }

line ~ /^\[/ {
	if (line ~ /^\[hooks\.[A-Za-z0-9_-]+\]$/) {
		ev = line
		sub(/^\[hooks\./, "", ev)
		sub(/\]$/, "", ev)
		if (mode == "events") print ev
	} else if (line ~ /^\[hooks\]$/) {
		ev = ""
	} else if (line ~ /^\[/) {
		ev = ""
	}
	next
}

line ~ /^name[ \t]*=/ {
	if (mode == "name") {
		v = line; sub(/^name[ \t]*=[ \t]*/, "", v)
		gsub(/^"|"$/, "", v)
		print v
	}
	next
}

line ~ /^run[ \t]*=/ {
	if (ev == "") fail("run outside a [hooks.<event>] section")
	buf = line
	sub(/^run[ \t]*=[ \t]*/, "", buf)
	if (index(buf, "]")) flush()
	else collecting = 1
	next
}

{ fail("unrecognised line: " line) }
'

manifest_read() { # <mode> <manifest> [event]
	awk -v mode="$1" -v want="${3:-}" "$MANIFEST_AWK" "$2"
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
	printf 'git-shook: %s\n' "$1" >&2
	exit 1
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# Where the dispatcher, the entries and the kept hooks are generated.
#
# Inside the git directory, because a generated hook set is one clone's
# activation rather than the repository's content. Nobody has to gitignore it,
# nothing can commit it by accident, and which hooks somebody runs beyond what
# the repository declares stays their own business. The tracked half is the
# manifest; this half never was.
#
# `--git-common-dir` and not `--git-dir`, since a linked worktree has a git
# directory of its own while `core.hooksPath` is one setting in the shared
# config. Taking the worktree's would point every worktree's dispatcher at a
# directory the one config never named.
shook_dir() { # <root>
	_d=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) ||
		die "not inside a git repository"
	case $_d in
	/*) ;;
	*) _d="$1/$_d" ;;
	esac
	printf '%s/shook' "$_d"
}

# Every manifest in the tree, one path per line. `git ls-files` rather than
# `find`, so a manifest has to be tracked to be found: an untracked one is
# somebody's scratch file and is not something to wire into a hook.
find_manifests() { # <root>
	git -C "$1" ls-files --full-name -- 'shook.toml' '*/shook.toml' 2>/dev/null | sort
}

# The name a manifest registers under, which decides its filename in the entry
# directory and therefore where it falls in the run order.
manifest_name() { # <root> <relative manifest path>
	n=$(manifest_read name "$1/$2")
	if [ -z "$n" ]; then
		n=$(dirname "$2")
		[ "$n" = "." ] && n=$(basename "$1")
		n=$(basename "$n")
	fi
	printf '%s' "$n"
}

# The name becomes a filename under the entry directory, so one carrying a slash
# or a `..` writes outside it. Measured before this check existed:
# `name = "../../escaped"` put a file at `.shook/escaped`.
#
# Called from the main shell rather than from inside `manifest_name`, because a
# `die` inside a command substitution exits the subshell and the script carries
# on with the bad name in hand. That is how the escape survived the first
# version of this check.
check_name() { # <manifest> <name>
	case $2 in
	"" | . | ..) die "$1: name is empty or a directory reference" ;;
	*/* | *\\*) die "$1: a name may not carry a path separator, found \"$2\"" ;;
	*[!A-Za-z0-9._-]*) die "$1: a name takes letters, digits, dot, dash and underscore, found \"$2\"" ;;
	esac
}

# Git's own hook events. An event outside this set is a section nothing will
# ever run, and `doctor` used to call such a manifest healthy, so it is refused
# at the point it is read rather than reported later.
KNOWN_EVENTS="applypatch-msg pre-applypatch post-applypatch pre-commit
pre-merge-commit prepare-commit-msg commit-msg post-commit pre-rebase
post-checkout post-merge pre-push pre-receive update proc-receive
post-receive post-update reference-transaction push-to-checkout pre-auto-gc
post-rewrite sendemail-validate fsmonitor-watchman p4-changelist
p4-prepare-changelist p4-post-changelist p4-pre-submit post-index-change"

check_event() { # <manifest> <event>
	for k in $KNOWN_EVENTS; do
		[ "$2" = "$k" ] && return 0
	done
	die "$1: git has no hook called \"$2\", so nothing would ever run it"
}

# Two manifests registering the same name at the same event would have the
# second overwrite the first, with both shown in the listing as if both had
# been registered.
SEEN=""
seen_name() { # <event> <name> <manifest>
	key="$1/$2"
	case " $SEEN " in
	*" $key "*) die "$3: $2 is already registered for $1 by another manifest; give one of them a different name" ;;
	esac
	SEEN="$SEEN $key"
}

# Where a manifest's hooks run, relative to the repository root. Empty for one
# at the root, which is why nothing here may go through a whitespace-separated
# field: an empty value has to survive being passed around.
manifest_dir() { # <relative manifest path>
	d=$(dirname "$1")
	[ "$d" = "." ] && d=""
	printf '%s' "$d"
}

# Every event any manifest declares, once each, in the order first seen.
collect_events() { # <root> <manifests>
	evs=""
	for m in $2; do
		for ev in $(manifest_read events "$1/$m"); do
			case " $evs " in
			*" $ev "*) ;;
			*) evs="$evs $ev" ;;
			esac
		done
	done
	printf '%s' "$evs"
}

# An argument list on one line for a person to read, with anything containing a
# space quoted so two arguments never look like one. Never used to reconstruct
# a command; the entry file is the thing that runs.
show_argv() { # <newline separated argv>
	printf '%s\n' "$1" | awk '{ if ($0 ~ /[ \t]/) printf "\"%s\" ", $0; else printf "%s ", $0 } END { print "" }'
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
	yes=0
	for a in "$@"; do
		case $a in
		-y | --yes) yes=1 ;;
		-*) die "unknown flag: $a" ;;
		esac
	done

	root=$(repo_root)
	manifests=$(find_manifests "$root")
	[ -n "$manifests" ] || die "no tracked shook.toml anywhere in $root"

	# Two passes over the manifests rather than one pass into a plan file. The
	# encoding that would need is a field separator that survives an empty
	# field, and shell `read` collapses runs of whitespace, so a tab-separated
	# plan silently loses an empty working directory and shifts everything
	# after it. Reading the manifests twice costs nothing and cannot do that.
	events=$(collect_events "$root" "$manifests")

	printf 'git-shook will register:\n\n'
	for m in $manifests; do
		name=$(manifest_name "$root" "$m")
		check_name "$m" "$name"
		wd=$(manifest_dir "$m")
		for ev in $(manifest_read events "$root/$m"); do
			check_event "$m" "$ev"
			argv=$(manifest_read argv "$root/$m" "$ev")
			[ -n "$argv" ] || die "$m: [hooks.$ev] has no run"
			seen_name "$ev" "$name" "$m"
			printf '  %-14s %-16s %s' "$ev" "$name" "$(show_argv "$argv")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			printf '\n'
		done
	done
	printf '\n'

	sd=$(shook_dir "$root")

	if [ "$yes" -eq 0 ]; then
		[ -t 0 ] || die "not a terminal, so pass --yes to install without confirming"
		printf 'Register these and point core.hooksPath at %s/hooks? [y/N] ' "$sd"
		read -r reply
		case $reply in
		y | Y | yes | YES) ;;
		*) die "nothing installed" ;;
		esac
	fi

	mkdir -p "$sd/hooks" "$sd/entries"

	# A hook that is already there is moved in beside the others rather than
	# replaced, so it keeps running and uninstall can put it back.
	migrate_existing "$root" "$events"

	for ev in $events; do
		mkdir -p "$sd/entries/$ev"
		dispatcher_text >"$sd/hooks/$ev"
		chmod +x "$sd/hooks/$ev"
	done

	for m in $manifests; do
		name=$(manifest_name "$root" "$m")
		check_name "$m" "$name"
		wd=$(manifest_dir "$m")
		for ev in $(manifest_read events "$root/$m"); do
			{
				printf '%s\n' "$wd"
				manifest_read argv "$root/$m" "$ev"
			} >"$sd/entries/$ev/$name"
		done
	done

	# Absolute, because the git directory is not always under the working tree:
	# a linked worktree's `.git` is a file, a submodule's is elsewhere entirely,
	# and git resolves a relative `core.hooksPath` against the working tree's
	# top level. One shape for every case, and `git shook doctor` catches the one
	# thing an absolute path costs, which is a clone that has since moved.
	git -C "$root" config core.hooksPath "$sd/hooks"

	# An older git-shook generated at the repository root. Nothing reads it now
	# and leaving it would put an untracked directory in everybody's status.
	#
	# Unless git tracks it, in which case deleting it is not tidying up, it is
	# a dirty tree that comes back on the next checkout and goes away again on
	# the next install, forever. Somebody committed those files on purpose and
	# this tool is not the one to decide they were wrong.
	if [ -d "$root/.shook" ]; then
		if [ -n "$(git -C "$root" ls-files -- .shook)" ]; then
			printf 'the .shook at the repository root is tracked, so it stays.\n'
			printf 'Nothing reads it any more; remove it from the repository when you are ready.\n'
		else
			rm -rf "$root/.shook"
			printf 'removed the old .shook at the repository root; it is in the git directory now\n'
		fi
	fi

	printf 'Registered. core.hooksPath is %s/hooks.\n' "$sd"
	printf 'It is in the git directory, so it is not committed and nobody has to ignore it,\n'
	printf 'and neither is the config line, so everyone who clones this runs `git shook install`.\n'
}

# An existing hook at an event we are about to take is moved to
# `<git-dir>/shook/entries/<event>/00-existing` so it still runs, first, and
# uninstall can put it back where it was.
migrate_existing() { # <root> <events>
	sd=$(shook_dir "$1")
	old=$(git -C "$1" config --get core.hooksPath || true)
	[ "$old" = "$sd/hooks" ] && return 0
	# The path an older git-shook used. Its dispatcher is ours, so migrating
	# from it would wrap this tool's own generated file as somebody's kept hook
	# and run every entry twice. What does have to come across is the kept
	# directory beside it: those are the hooks this tool took custody of the
	# first time and promised `uninstall` would give back, and `install`
	# removes the directory holding them a few lines later.
	if [ "$old" = ".shook/hooks" ]; then
		migrate_legacy_kept "$1"
		return 0
	fi

	case $old in
	# An absolute hooksPath is already a path and must not be joined to the
	# root, which would produce `/repo//etc/git/hooks`.
	/*) from=$old ;;
	"")
		# `.git` is a file rather than a directory in a linked worktree and
		# in a submodule, so the hooks directory is not `$root/.git/hooks`
		# there. Ask git where it is instead of assuming.
		from=$(git -C "$1" rev-parse --git-path hooks 2>/dev/null) || from="$1/.git/hooks"
		case $from in
		/*) ;;
		*) from="$1/$from" ;;
		esac
		;;
	*) from="$1/$old" ;;
	esac

	for ev in $2; do
		h="$from/$ev"
		[ -f "$h" ] || continue
		mkdir -p "$sd/entries/$ev" "$sd/kept"
		cp "$h" "$sd/kept/$ev"
		chmod +x "$sd/kept/$ev"
		{
			printf '\n'
			# Run it directly rather than through `sh`. It carries its own
			# shebang and it is as likely to be python or perl as shell, in
			# which case `sh` turns a hook that worked into a syntax error
			# while the tool reports it was kept.
			#
			# Absolute, for the same reason `core.hooksPath` is: the git
			# directory is not reliably under the working tree, so a path
			# relative to either is wrong somewhere.
			printf '%s\n' "$sd/kept/$ev"
		} >"$sd/entries/$ev/00-existing"
		printf 'kept the %s hook that was already here, as 00-existing\n' "$ev"
	done
}

# The hooks an older git-shook kept, at `<root>/.shook/kept/<event>`, moved
# into the git directory beside everything else.
#
# Every file there, rather than only the events being registered now: a
# manifest that has since dropped an event still leaves that hook in the kept
# directory, `uninstall` restores whatever it finds there without asking which
# events are live, and `install` is about to delete the directory. Filtering by
# the current event set would lose exactly the hook nobody is thinking about.
migrate_legacy_kept() { # <root>
	sd=$(shook_dir "$1")
	[ -d "$1/.shook/kept" ] || return 0
	for k in "$1"/.shook/kept/*; do
		[ -f "$k" ] || continue
		ev=${k##*/}
		mkdir -p "$sd/entries/$ev" "$sd/kept"
		cp "$k" "$sd/kept/$ev"
		chmod +x "$sd/kept/$ev"
		# The same two lines `migrate_existing` writes: an empty working
		# directory, then the command, run directly so it keeps its own
		# shebang.
		printf '\n%s\n' "$sd/kept/$ev" >"$sd/entries/$ev/00-existing"
		printf 'moved the %s hook the older layout was keeping\n' "$ev"
	done
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

cmd_list() {
	root=$(repo_root)
	sd=$(shook_dir "$root")
	d="$sd/entries"
	if [ ! -d "$d" ]; then
		printf 'nothing registered\n'
		return 0
	fi
	for ev in "$d"/*; do
		[ -d "$ev" ] || continue
		printf '%s\n' "${ev##*/}"
		for e in "$ev"/*; do
			[ -f "$e" ] || continue
			wd=$(head -n 1 "$e")
			printf '  %-16s %s' "${e##*/}" "$(show_argv "$(tail -n +2 "$e")")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			printf '\n'
		done
	done
	active=$(git -C "$root" config --get core.hooksPath || printf '(unset)')
	printf '\ncore.hooksPath: %s\n' "$active"
	[ "$active" = "$sd/hooks" ] || printf 'not active here: run `git shook install`\n'
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
	root=$(repo_root)
	sd=$(shook_dir "$root")
	bad=0

	active=$(git -C "$root" config --get core.hooksPath || printf '')
	if [ "$active" != "$sd/hooks" ]; then
		printf 'core.hooksPath is "%s", so nothing here runs. Run `git shook install`.\n' "$active"
		# The one thing an absolute hooksPath costs. Worth saying which of the
		# two it is, because "run install" reads as a fresh setup rather than
		# as a repair somebody already did once.
		case $active in
		/*)
			[ -d "$active" ] ||
				printf 'It points at a directory that is not there, so this clone has moved.\n'
			;;
		esac
		bad=1
	fi

	for m in $(find_manifests "$root"); do
		for ev in $(manifest_read events "$root/$m"); do
			name=$(manifest_name "$root" "$m")
			if [ ! -f "$sd/entries/$ev/$name" ]; then
				printf '%s declares [hooks.%s] and is not registered. Run `git shook install`.\n' "$m" "$ev"
				bad=1
			fi
		done
	done

	if [ -d "$sd/entries" ]; then
		for ev in "$sd"/entries/*; do
			[ -d "$ev" ] || continue
			e="$sd/hooks/${ev##*/}"
			if [ ! -x "$e" ]; then
				printf 'entries exist for %s with no dispatcher. Run `git shook install`.\n' "${ev##*/}"
				bad=1
			fi
		done
	fi

	# An older git-shook generated at the repository root, where it showed up in
	# everybody's `git status` and had to be ignored by hand. Install clears it,
	# unless somebody committed it, in which case only they can.
	if [ -d "$root/.shook" ]; then
		if [ -n "$(git -C "$root" ls-files -- .shook)" ]; then
			printf 'a .shook directory is tracked at the repository root. Nothing reads it; `git rm -r .shook`.\n'
		else
			printf 'a .shook directory is still at the repository root. Run `git shook install` to clear it.\n'
		fi
		bad=1
	fi

	[ "$bad" -eq 0 ] && printf 'all good\n'
	return $bad
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
	root=$(repo_root)
	sd=$(shook_dir "$root")
	if [ -d "$sd/kept" ]; then
		for k in "$sd"/kept/*; do
			[ -f "$k" ] || continue
			# Same as the migration: ask git where hooks live rather than
			# assuming `.git/hooks`, which is wrong in a linked worktree and
			# in a submodule.
			hd=$(git -C "$root" rev-parse --git-path hooks 2>/dev/null) || hd="$root/.git/hooks"
			case $hd in /*) ;; *) hd="$root/$hd" ;; esac
			mkdir -p "$hd"
			cp "$k" "$hd/${k##*/}"
			chmod +x "$hd/${k##*/}"
			printf 'put back the %s hook that was here before\n' "${k##*/}"
		done
	fi
	git -C "$root" config --unset core.hooksPath 2>/dev/null || true
	rm -rf "$sd"
	# And whatever an older git-shook left at the repository root, on the same
	# terms `install` uses: a tracked one is somebody's committed file and not
	# this tool's to delete.
	if [ -d "$root/.shook" ] && [ -z "$(git -C "$root" ls-files -- .shook)" ]; then
		rm -rf "$root/.shook"
	fi
	printf 'removed %s and cleared core.hooksPath\n' "$sd"
}

# ---------------------------------------------------------------------------

usage() {
	cat <<'HELPTEXT'
git-shook: hooks that shook on it.

Git runs one program per hook event, so a tool that installs a hook replaces
whatever was there. git-shook puts one dispatcher at the event and gives every
tool a place to register beside the others.

USAGE
    git shook <command>

COMMANDS
    install [--yes]   Read every tracked shook.toml, show what each would run,
                      and register it once you say so.
    list              What is registered, per event, in the order it runs.
    doctor            Whether what is declared and what is registered agree.
    uninstall         Remove the registry and put back the hook that was here.
    version           Print the version.

A shook.toml declares what its own project wants run:

    name = "ante"

    [hooks.pre-commit]
    run = ["ante", "fix"]

`run` is an argument list rather than a command line, so nothing goes through a
shell and there is no quoting to get wrong. It runs with the manifest's own
directory as its working directory. A hook that needs a pipe or a redirect ships
a script and names it, which puts it in a diff where somebody can object to it.

Discovery happens when you run `install`, never when a hook fires, so a manifest
arriving through a merge does nothing until you look at it and say yes.
HELPTEXT
}

case "${1:-}" in
install)
	shift
	cmd_install "$@"
	;;
list)
	shift
	cmd_list "$@"
	;;
doctor)
	shift
	cmd_doctor "$@"
	;;
uninstall)
	shift
	cmd_uninstall "$@"
	;;
dispatcher)
	dispatcher_text
	;;
version | --version | -V)
	printf 'git-shook %s\n' "$VERSION"
	;;
help | --help | -h | "")
	usage
	;;
*)
	die "unknown command: $1 (try \`git shook help\`)"
	;;
esac
