#
# git-shook: hooks that shook on it.
#
# Git runs one program per hook event, so a tool that installs a hook replaces
# whatever was there. This puts one dispatcher at the event and gives every tool
# a place to register beside the others.
#
# POSIX sh and awk throughout, deliberately. What lives at a hook event runs on
# every commit for everybody who clones the repository, including people who
# have none of the toolchain that installed it, so it may not depend on anything
# that could be missing.

set -u

VERSION=0.1.0
DISPATCH_VERSION=3

# ---------------------------------------------------------------------------
# the dispatcher
#
# This is what goes at the hook event. It works out what git handed the event,
# and hands the event's chain to the base, `shook`, which runs the entries in
# order and stops at the first that fails. What is git's is decided here and
# nowhere else: which events feed stdin, which paths an event touched, which
# entries those paths select, and the one event whose stdout is a protocol.
#
# An entry is data rather than a script: the first line is the directory to run
# in, relative to the repository root, and every line after it is one argument.
# Generating a script instead would mean quoting arguments back into shell text,
# which is the injection the argument list exists to prevent.
# ---------------------------------------------------------------------------

dispatcher_text() {
	cat <<DISPATCH
#!/bin/sh
# git-shook dispatcher v$DISPATCH_VERSION
# Generated by git-shook. Do not edit: \`git shook install\` rewrites it.
#
# Hands every entry registered for this event to the base beside it, which runs
# them in sorted order and stops at the first one that fails. \`git shook list\`
# shows what is registered.

# Sorted means one thing only if the collation is fixed. Without this the run
# order is the user's locale, which is not an order anybody can reason about.
LC_ALL=C
export LC_ALL

ev=\${0##*/}

# A bare repository has no work tree, so \`--show-toplevel\` fails there and the
# push hooks a bare repository exists to run would be silently inert. Fall back
# to the git directory, which is where a bare repository keeps everything.
root=\$(git rev-parse --show-toplevel 2>/dev/null) ||
	root=\$(git rev-parse --absolute-git-dir 2>/dev/null) || exit 0

# The entries live beside this script, in the git directory, and the shared one
# rather than a linked worktree's, since one \`core.hooksPath\` serves them all.
g=\$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
case \$g in
/*) ;;
*) g="\$(pwd)/\$g" ;;
esac

d="\$g/shook/entries/\$ev"
[ -d "\$d" ] || exit 0
base="\$g/shook/shook"
if [ ! -x "\$base" ]; then
	printf 'git-shook: the base is missing at %s, so nothing at %s ran. Run \`git shook install\`.\n' "\$base" "\$ev" >&2
	exit 1
fi

# Anything git handed us by a path relative to the current directory has to be
# made absolute before an entry is run somewhere else, or it resolves against
# the wrong directory. \`GIT_INDEX_FILE\` is the one that bites, because a
# program that is not git itself reads it verbatim.
if [ -n "\${GIT_INDEX_FILE:-}" ]; then
	case \$GIT_INDEX_FILE in
	/*) ;;
	*)
		GIT_INDEX_FILE="\$(pwd)/\$GIT_INDEX_FILE"
		export GIT_INDEX_FILE
		;;
	esac
fi

# Only the events git feeds on stdin have it read and replayed to every entry.
# Every other event reads nothing: git does not close stdin for all of them
# (\`core.fsmonitor\` inherits the caller's), so waiting for its end can wait
# forever, and reading it takes input that belongs to whoever ran git, such as
# the rest of a \`while read\` loop. Those entries get /dev/null, as git gives a
# hook it feeds nothing. \`proc-receive\` speaks a protocol both ways and is
# passed the stream itself; \`push-to-checkout\` takes its commit as an argument.
mode=none
case \$ev in
pre-push | pre-receive | post-receive | post-rewrite | reference-transaction) mode=replay ;;
proc-receive) mode=pass ;;
esac

tmp=\$(mktemp -d 2>/dev/null || mktemp -d -t git-shook) || exit 1
trap 'rm -rf "\$tmp"' EXIT

# At \`fsmonitor-watchman\` stdout is the protocol, so one entry answers it and
# every other one runs for its side effects with stdout thrown away. The answer
# is the entry named in \`answers/<event>\`, and with none there the floor, which
# tells git everything may have changed. This is the one event git-shook runs
# itself, since what it does with each entry's stdout is no chain's business.
if [ "\$ev" = fsmonitor-watchman ]; then
	for a in "\$@"; do printf '%s\\n' "\$a"; done >"\$tmp/argv"
	fm_ver=\${1:-} fm_tok=\${2:-}
	ans=""
	[ -f "\$g/shook/answers/\$ev" ] && ans=\$(head -n 1 "\$g/shook/answers/\$ev")
	[ -n "\$ans" ] && [ -f "\$d/\$ans" ] || ans=""
	st=0
	for e in "\$d"/*; do
		[ -f "\$e" ] || continue
		wd=\$(head -n 1 "\$e")
		tail -n +2 "\$e" >"\$tmp/entry"
		set --
		while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/entry"
		[ \$# -gt 0 ] || continue
		while IFS= read -r a; do set -- "\$@" "\$a"; done <"\$tmp/argv"
		if [ "\${e##*/}" != "\$ans" ]; then
			( cd "\$root/\$wd" 2>/dev/null || exit 127; exec "\$@" ) </dev/null >/dev/null || { st=\$?; break; }
		else
			( cd "\$root/\$wd" 2>/dev/null || exit 127; exec "\$@" ) </dev/null || { st=\$?; break; }
		fi
	done
	if [ \$st -eq 0 ] && [ -z "\$ans" ]; then
		# Version 2 hands over the last token and wants a token first; version 1
		# wants the paths alone. A path of \`/\` is every path.
		if [ "\$fm_ver" = 1 ]; then printf '/\\0'; else printf '%s\\0/\\0' "\${fm_tok:-git-shook}"; fi
	fi
	exit \$st
fi

# An entry registered with \`paths\` runs only where the event touched a path one
# of its globs matches, and an argument that is exactly \`{paths}\` becomes those
# paths, one argument each. What an event touches: what is staged, at
# \`pre-commit\` and \`commit-msg\`; at \`pre-push\`, every path a pushed tip adds
# over its remote, or every path it carries where the remote is new or a commit
# this clone does not have; at every other event nothing, so an entry with
# globs never runs there and \`install\` refuses one. Where any entry has globs,
# the chain handed to the base is the selected one, written beside this run.
c="\$g/shook/conditions/\$ev"
chain=\$d

if [ -d "\$c" ] && [ -n "\$(ls "\$c")" ]; then
	if [ "\$mode" = replay ]; then
		cat >"\$tmp/stdin"
		exec <"\$tmp/stdin"
	fi
	z=0000000000000000000000000000000000000000
	{
		case \$ev in
		pre-commit | commit-msg) git -C "\$root" diff --cached --name-only -z ;;
		pre-push)
			while read -r _lr ls _rr rs; do
				[ -n "\${ls:-}" ] && [ "\$ls" != \$z ] || continue
				if [ "\$rs" != \$z ] && git -C "\$root" cat-file -e "\$rs" 2>/dev/null; then
					git -C "\$root" diff --name-only -z "\$rs" "\$ls"
				else
					git -C "\$root" ls-tree -r --name-only -z "\$ls"
				fi
			done <"\$tmp/stdin"
			;;
		esac
	} | tr '\\000' '\\n' | awk '!seen[\$0]++' >"\$tmp/touched"
	chain="\$tmp/chain"
	mkdir "\$chain"
	for e in "\$d"/*; do
		[ -f "\$e" ] || continue
		n=\${e##*/}
		if [ ! -f "\$c/\$n" ]; then
			cp "\$e" "\$chain/\$n"
			continue
		fi
		: >"\$tmp/matched"
		while IFS= read -r p; do
			while IFS= read -r glob; do
				case \$p in
				\$glob)
					printf '%s\\n' "\$p" >>"\$tmp/matched"
					break
					;;
				esac
			done <"\$c/\$n"
		done <"\$tmp/touched"
		[ -s "\$tmp/matched" ] || continue
		head -n 1 "\$e" >"\$chain/\$n"
		tail -n +2 "\$e" | while IFS= read -r a; do
			if [ "\$a" = "{paths}" ]; then cat "\$tmp/matched"; else printf '%s\\n' "\$a"; fi
		done >>"\$chain/\$n"
	done
fi

"\$base" run --root "\$root" --stdin "\$mode" "\$chain" "\$@"
exit \$?
DISPATCH
}

# ---------------------------------------------------------------------------
# the manifest reader
#
# One awk program, several modes. It reads the subset of toml the format uses and
# refuses the rest by name, rather than accepting something it cannot render.
#
# The string walk is character by character and tracks whether it is inside a
# quote, which is the whole reason it is not a `split` on commas: an argument
# containing a comma would be torn in two and neither half would unquote.
# ---------------------------------------------------------------------------

MANIFEST_AWK='
function fail(msg) { print FILENAME ":" FNR ": " msg > "/dev/stderr"; exit 2 }

function unquote(buf,   i, c, inq, esc, cur, n) {
	inq = 0; esc = 0; cur = ""; n = 0
	for (i = 1; i <= length(buf); i++) {
		c = substr(buf, i, 1)
		if (inq) {
			if (esc) {
				# An entry file is one argument per line, so an argument
				# holding a newline cannot be written down at all. Refused
				# here rather than decoded, because decoded it would become
				# two arguments and nothing downstream could tell.
				if (c == "n") fail("an argument may not contain a newline")
				else if (c == "t") cur = cur "\t"
				else cur = cur c
				esc = 0
			} else if (c == "\\") esc = 1
			else if (c == "\"") { out[n++] = cur; inq = 0; cur = "" }
			else cur = cur c
		} else if (c == "\"") { inq = 1; cur = "" }
		else if (c != "," && c != "[" && c != "]" && c != " " && c != "\t")
			fail("a run entry takes quoted strings only, found " c)
	}
	if (inq) fail("unterminated string")
	return n
}

function flush(   i, n) {
	if (buf == "") return
	n = unquote(buf)
	if (mode == key && ev == want) for (i = 0; i < n; i++) print out[i]
	buf = ""
}

{ line = $0; sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line) }

collecting {
	buf = buf " " line
	if (index(line, "]")) { collecting = 0; flush() }
	next
}

line ~ /^#/ || line == "" { next }

line ~ /^\[/ {
	if (line ~ /^\[hooks\.[A-Za-z0-9_-]+\]$/) {
		ev = line
		sub(/^\[hooks\./, "", ev)
		sub(/\]$/, "", ev)
		if (mode == "events") print ev
	} else if (line ~ /^\[hooks\]$/) {
		ev = ""
	} else if (line ~ /^\[/) {
		ev = ""
	}
	next
}

line ~ /^name[ \t]*=/ {
	if (mode == "name") {
		v = line; sub(/^name[ \t]*=[ \t]*/, "", v)
		gsub(/^"|"$/, "", v)
		print v
	}
	next
}

# Whether this entry answers a hook whose stdout is a protocol. Only
# `fsmonitor-watchman` has one that several entries could talk over, so the key
# is refused anywhere else rather than accepted and meaning nothing.
line ~ /^answers[ \t]*=/ {
	if (ev == "") fail("answers outside a [hooks.<event>] section")
	v = line; sub(/^answers[ \t]*=[ \t]*/, "", v)
	if (v != "true" && v != "false") fail("answers takes true or false, found " v)
	if (ev != "fsmonitor-watchman") fail("answers is for fsmonitor-watchman only, found it under " ev)
	if (mode == "answers" && v == "true") print ev
	next
}

line ~ /^run[ \t]*=/ {
	if (ev == "") fail("run outside a [hooks.<event>] section")
	buf = line; key = "argv"
	sub(/^run[ \t]*=[ \t]*/, "", buf)
	if (index(buf, "]")) flush()
	else collecting = 1
	next
}

# The globs an entry runs for. Only the events that touch paths have any, so the
# key is refused anywhere else rather than accepted and never run.
line ~ /^paths[ \t]*=/ {
	if (ev == "") fail("paths outside a [hooks.<event>] section")
	if (ev != "pre-commit" && ev != "commit-msg" && ev != "pre-push")
		fail("paths is for pre-commit, commit-msg and pre-push, which touch paths; found it under " ev)
	if (mode == "conditioned" && ev == want) print ev
	buf = line; key = "paths"
	sub(/^paths[ \t]*=[ \t]*/, "", buf)
	if (index(buf, "]")) flush()
	else collecting = 1
	next
}

{ fail("unrecognised line: " line) }
'

manifest_read() { # <mode> <manifest> [event]
	awk -v mode="$1" -v want="${3:-}" "$MANIFEST_AWK" "$2"
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
	printf 'git-shook: %s\n' "$1" >&2
	exit 1
}

repo_root() {
	git rev-parse --show-toplevel 2>/dev/null || die "not inside a git repository"
}

# The base this front runs on: the `shook` that came with this script, beside it
# where it was installed, else the one on PATH. Printed, or nothing where there
# is none, since what to do about that is the caller's to say.
find_base() {
	_s=$0
	case $_s in */*) ;; *) _s=$(command -v "$_s" 2>/dev/null) || _s="" ;; esac
	if [ -n "$_s" ] && [ -f "${_s%/*}/shook" ]; then
		printf '%s' "${_s%/*}/shook"
		return 0
	fi
	command -v shook 2>/dev/null || true
}

# Where the dispatcher, the entries and the kept hooks are generated.
#
# Inside the git directory, because a generated hook set is one clone's
# activation rather than the repository's content. Nobody has to gitignore it,
# nothing can commit it by accident, and which hooks somebody runs beyond what
# the repository declares stays their own business. The tracked half is the
# manifest; this half never was.
#
# `--git-common-dir` and not `--git-dir`, since a linked worktree has a git
# directory of its own while `core.hooksPath` is one setting in the shared
# config. Taking the worktree's would point every worktree's dispatcher at a
# directory the one config never named.
shook_dir() { # <root>
	_d=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) ||
		die "not inside a git repository"
	case $_d in
	/*) ;;
	*) _d="$1/$_d" ;;
	esac
	printf '%s/shook' "$_d"
}

# Every manifest in the tree, one path per line. `git ls-files` rather than
# `find`, so a manifest has to be tracked to be found: an untracked one is
# somebody's scratch file and is not something to wire into a hook.
# The list is handed around one path to a line and read with `read -r` from a
# here-document, never as words, so a path with whitespace or glob characters is
# one manifest and is neither split nor expanded.
find_manifests() { # <root>
	# The clone's own manifests come first, as absolute paths, so they win a
	# name a tracked manifest also uses. They sit in the git directory beside
	# the registry they feed, which makes them local to this clone and not
	# something a merge can bring in: whoever put one there is the operator,
	# and `install` is still the step that says yes to it.
	_ld="$(shook_dir "$1")/manifests"
	if [ -d "$_ld" ]; then
		for _f in "$_ld"/*.toml; do
			[ -f "$_f" ] && printf '%s\n' "$_f"
		done
	fi
	git -C "$1" ls-files --full-name -- 'shook.toml' '*/shook.toml' 2>/dev/null | sort
}

# The file a manifest path names: a clone-local one is already absolute, a
# tracked one is relative to the repository root.
mf() { # <root> <manifest path>
	case $2 in
	/*) printf '%s' "$2" ;;
	*) printf '%s/%s' "$1" "$2" ;;
	esac
}

# The name a manifest registers under, which decides its filename in the entry
# directory and therefore where it falls in the run order.
manifest_name() { # <root> <relative manifest path>
	n=$(manifest_read name "$(mf "$1" "$2")")
	if [ -z "$n" ]; then
		case $2 in
		/*) n=$(basename "$2" .toml) ;;
		*)
			n=$(dirname "$2")
			[ "$n" = "." ] && n=$(basename "$1")
			n=$(basename "$n")
			;;
		esac
	fi
	printf '%s' "$n"
}

# The name becomes a filename under the entry directory, so one carrying a slash
# or a `..` writes outside it. Measured before this check existed:
# `name = "../../escaped"` put a file at `.shook/escaped`.
#
# Called from the main shell rather than from inside `manifest_name`, because a
# `die` inside a command substitution exits the subshell and the script carries
# on with the bad name in hand. That is how the escape survived the first
# version of this check.
check_name() { # <manifest> <name>
	case $2 in
	"" | . | ..) die "$1: name is empty or a directory reference" ;;
	*/* | *\\*) die "$1: a name may not carry a path separator, found \"$2\"" ;;
	*[!A-Za-z0-9._-]*) die "$1: a name takes letters, digits, dot, dash and underscore, found \"$2\"" ;;
	esac
}

# Git's own hook events. An event outside this set is a section nothing will
# ever run, and `doctor` used to call such a manifest healthy, so it is refused
# at the point it is read rather than reported later.
KNOWN_EVENTS="applypatch-msg pre-applypatch post-applypatch pre-commit
pre-merge-commit prepare-commit-msg commit-msg post-commit pre-rebase
post-checkout post-merge pre-push pre-receive update proc-receive
post-receive post-update reference-transaction push-to-checkout pre-auto-gc
post-rewrite sendemail-validate fsmonitor-watchman p4-changelist
p4-prepare-changelist p4-post-changelist p4-pre-submit post-index-change"

check_event() { # <manifest> <event>
	for k in $KNOWN_EVENTS; do
		[ "$2" = "$k" ] && return 0
	done
	die "$1: git has no hook called \"$2\", so nothing would ever run it"
}

# Two manifests registering the same name at the same event would have the
# second overwrite the first, with both shown in the listing as if both had
# been registered.
SEEN=""
LOCALS=""
seen_name() { # <event> <name> <manifest>
	key="$1/$2"
	case " $SEEN " in
	*" $key "*) die "$3: $2 is already registered for $1 by another manifest; give one of them a different name" ;;
	esac
	SEEN="$SEEN $key"
	case $3 in /*) LOCALS="$LOCALS $key" ;; esac
}

# Whether a tracked manifest's hook is the one a clone-local manifest of the
# same name already declares for the same event. The clone's own declaration is
# the more specific, and a tool that generates its local manifest from a wider
# source than the tracked file can see (a layer that is not committed) has to be
# able to say the same thing there without the two registering twice. The local
# manifests are read first, so by the time a tracked one is asked about this,
# `LOCALS` holds them.
PLANNED=""
ANSWERED=""

# One entry answers `fsmonitor-watchman` and no more, since two writing the
# protocol to one stdout is a reply git cannot read. Refused while planning,
# before anything is written.
answer_claim() { # <manifest> <event> <name>
	for _a in $ANSWERED; do
		case $_a in "$2="*) die "$1: ${_a#*=} already answers $2, and only one entry may" ;; esac
	done
	ANSWERED="$ANSWERED $2=$3"
}

answerer() { # <event>
	for _a in $ANSWERED; do
		case $_a in "$1="*) printf '%s' "${_a#*=}"; return 0 ;; esac
	done
}

# Which entry answers each protocol event, written to `answers/<event>` where
# the dispatcher reads it. A manifest that declares `answers` is the one; with
# none, the hook that was already here, since that was answering before this
# tool took the event over. Called once the entries are written.
record_answers() { # <shook dir> <events>
	for _e in $2; do
		[ "$_e" = fsmonitor-watchman ] || continue
		_w=$(answerer "$_e")
		if [ -z "$_w" ]; then
			_o=$(head -n 1 "$1/answers/$_e" 2>/dev/null)
			# under `--only` an answer from a manifest not looked at stands
			if [ -n "$only" ] && [ -n "$_o" ] && [ "$_o" != 00-existing ] &&
				[ -f "$1/entries/$_e/$_o" ] && ! case " $PLANNED " in *" $_o "*) true ;; *) false ;; esac; then
				_w=$_o
			elif [ -f "$1/entries/$_e/00-existing" ]; then
				_w=00-existing
			fi
		fi
		mkdir -p "$1/answers"
		if [ -n "$_w" ]; then
			printf '%s\n' "$_w" >"$1/answers/$_e"
		else
			rm -f "$1/answers/$_e"
		fi
	done
}

# A manifest answering where something registered already does: the hook that
# was here, or under `--only` the entry of a manifest this install leaves alone.
# Asked before anything moves, so a refusal leaves the old hook where git still
# runs it: one already kept, or one in the old directory that install would keep.
answers_free() { # <shook dir> <old hooks dir> <root> <manifests>
	for _a in $ANSWERED; do
		_e=${_a%%=*}
		_h=""
		# A kept hook that runs what a manifest registers now is dropped by this
		# install (the loop after the entries are written), so it answers nothing.
		if [ -f "$1/entries/$_e/00-existing" ]; then
			if ! [ -f "$1/kept/$_e" ] || ! declares_this_hook "$3" "$4" "$_e" "$1/kept/$_e"; then
				_h=1
			fi
		elif [ -n "$2" ] && [ -f "$2/$_e" ] && ! grep -q 'git-shook dispatcher' "$2/$_e" &&
			! declares_this_hook "$3" "$4" "$_e" "$2/$_e"; then
			_h=1
		fi
		[ -z "$_h" ] ||
			die "${_a#*=}: the hook that was here already answers $_e, and only one entry may; take it out, or drop answers"
		[ -n "$only" ] || continue
		_o=$(head -n 1 "$1/answers/$_e" 2>/dev/null)
		[ -n "$_o" ] && [ "$_o" != "${_a#*=}" ] && [ -f "$1/entries/$_e/$_o" ] || continue
		case " $PLANNED " in *" $_o "*) continue ;; esac
		die "${_a#*=}: $_o already answers $_e, and only one entry may"
	done
}

shadowed() { # <event> <name> <manifest>
	case $3 in /*) return 1 ;; esac
	# By name, not by event: the local manifest replaces the tracked one whole,
	# so an event only the tracked one declares stops registering with it. A
	# replacement that left the rest of the old manifest running would be a
	# merge, and the documentation promises a replacement.
	case " $LOCALS " in *"/$2 "*) return 0 ;; esac
	return 1
}

# Where a manifest's hooks run, relative to the repository root. Empty for one
# at the root, which is why nothing here may go through a whitespace-separated
# field: an empty value has to survive being passed around.
manifest_dir() { # <relative manifest path>
	case $1 in
	/*)
		# a clone-local manifest runs from the repository root
		printf ''
		return 0
		;;
	esac
	d=$(dirname "$1")
	[ "$d" = "." ] && d=""
	printf '%s' "$d"
}

# Every event any manifest declares, once each, in the order first seen.
collect_events() { # <root> <manifests>
	evs=""
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		for ev in $(manifest_read events "$(mf "$1" "$m")"); do
			case " $evs " in
			*" $ev "*) ;;
			*) evs="$evs $ev" ;;
			esac
		done
	done <<EOF
$2
EOF
	printf '%s' "$evs"
}

# An argument list on one line for a person to read, with anything containing a
# space quoted so two arguments never look like one. Never used to reconstruct
# a command; the entry file is the thing that runs.
show_argv() { # <newline separated argv>
	printf '%s\n' "$1" | awk '{ if ($0 ~ /[ \t]/) printf "\"%s\" ", $0; else printf "%s ", $0 } END { print "" }'
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------

cmd_install() {
	yes=0
	only=""
	while [ $# -gt 0 ]; do
		case $1 in
		-y | --yes) yes=1 ;;
		--only)
			[ $# -ge 2 ] || die "--only takes a manifest name"
			check_name "--only" "$2"
			only="$only $2"
			shift
			;;
		-*) die "unknown flag: $1" ;;
		esac
		shift
	done

	root=$(repo_root)
	manifests=$(find_manifests "$root")
	[ -n "$manifests" ] || die "no tracked shook.toml anywhere in $root, and none in $(shook_dir "$root")/manifests"
	base_src=$(find_base)
	[ -n "$base_src" ] ||
		die "git-shook runs its hooks on shook, which is neither beside $0 nor on PATH; install both with the installer that came with git-shook"

	# A clone-local manifest replaces a tracked one of its name as a whole, even
	# one that declares no event, so the names are noted before anything is
	# planned and not as each event is read.
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		case $m in /*) LOCALS="$LOCALS none/$(manifest_name "$root" "$m")" ;; esac
	done <<EOF
$manifests
EOF

	# `--only` registers the named manifests and leaves every other one
	# unregistered: `install --yes` is the consent for what the caller named,
	# and a manifest that arrived through a merge is still waiting to be looked
	# at. The registry entries of the others are neither written nor pruned.
	# Every event any manifest declares gets a dispatcher and has the hook that
	# is already there adopted, named or not: taking `core.hooksPath` stops git
	# reading the old directory for all of them, so a hook at an event the named
	# manifests do not declare would otherwise stop running for good.
	all_events=""
	for _e in $(collect_events "$root" "$manifests"); do
		for _k in $KNOWN_EVENTS; do
			[ "$_e" = "$_k" ] && all_events="$all_events $_e"
		done
	done
	# And an event no manifest declares at all but where a hook already sits: git
	# stops reading that directory for it too, so it is adopted and given a
	# dispatcher like the rest, or it would stop running with nothing said.
	_od=$(old_hooks_dir "$root")
	if [ -n "$_od" ]; then
		for _k in $KNOWN_EVENTS; do
			[ -f "$_od/$_k" ] || continue
			case " $all_events " in *" $_k "*) continue ;; esac
			all_events="$all_events $_k"
		done
	fi
	if [ -n "$only" ]; then
		kept=""
		while IFS= read -r m; do
			[ -n "$m" ] || continue
			n=$(manifest_name "$root" "$m")
			case " $only " in *" $n "*) kept="$kept
$m" ;; esac
		done <<EOF
$manifests
EOF
		for _n in $only; do
			found=""
			while IFS= read -r m; do
				[ -n "$m" ] || continue
				[ "$(manifest_name "$root" "$m")" = "$_n" ] && found=1
			done <<EOF
$manifests
EOF
			[ -n "$found" ] || die "no manifest answers to: $_n"
		done
		[ -n "$kept" ] || die "no manifest answers to:$only"
		manifests=$(printf '%s\n' "$kept" | sed '/^$/d')
	fi

	# Two passes over the manifests rather than one pass into a plan file. The
	# encoding that would need is a field separator that survives an empty
	# field, and shell `read` collapses runs of whitespace, so a tab-separated
	# plan silently loses an empty working directory and shifts everything
	# after it. Reading the manifests twice costs nothing and cannot do that.
	printf 'git-shook will register:\n\n'
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		name=$(manifest_name "$root" "$m")
		check_name "$m" "$name"
		wd=$(manifest_dir "$m")
		# Read whole and on its own, since awk refusing a key after the `run`
		# it already printed would otherwise leave the argument list standing.
		answers=$(manifest_read answers "$(mf "$root" "$m")") || die "$m: refused, nothing installed"
		for ev in $(manifest_read events "$(mf "$root" "$m")"); do
			check_event "$m" "$ev"
			argv=$(manifest_read argv "$(mf "$root" "$m")" "$ev")
			[ -n "$argv" ] || die "$m: [hooks.$ev] has no run"
			globs=$(manifest_read paths "$(mf "$root" "$m")" "$ev")
			conditioned=$(manifest_read conditioned "$(mf "$root" "$m")" "$ev")
			[ -z "$conditioned" ] || [ -n "$globs" ] ||
				die "$m: [hooks.$ev] has paths with no glob in it, so it would never run; give it one, or drop paths"
			if [ -z "$conditioned" ] && printf '%s\n' "$argv" | grep -qx '{paths}'; then
				die "$m: [hooks.$ev] runs with {paths} and has no paths to select them; add paths = [\"<glob>\", ...]"
			fi
			if shadowed "$ev" "$name" "$m"; then
				printf '  %-14s %-16s replaced by this clone'"'"'s own manifest of that name\n' "$ev" "$name"
				continue
			fi
			seen_name "$ev" "$name" "$m"
			PLANNED="$PLANNED $name"
			case " $answers " in *" $ev "*) answer_claim "$m" "$ev" "$name" ;; esac
			printf '  %-14s %-16s %s' "$ev" "$name" "$(show_argv "$argv")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			case " $answers " in *" $ev "*) printf ' (answers)' ;; esac
			[ -n "$globs" ] && printf ' (for %s)' "$(printf '%s\n' "$globs" | paste -sd ' ' -)"
			printf '\n'
		done
	done <<EOF
$manifests
EOF
	printf '\n'

	sd=$(shook_dir "$root")
	answers_free "$sd" "$_od" "$root" "$manifests"

	if [ "$yes" -eq 0 ]; then
		[ -t 0 ] || die "not a terminal, so pass --yes to install without confirming"
		printf 'Register these and point core.hooksPath at %s/hooks? [y/N] ' "$sd"
		read -r reply
		case $reply in
		y | Y | yes | YES) ;;
		*) die "nothing installed" ;;
		esac
	fi

	mkdir -p "$sd/hooks" "$sd/entries"

	# A hook that is already there is moved in beside the others rather than
	# replaced, so it keeps running and uninstall can put it back.
	migrate_existing "$root" "$all_events" "$manifests"

	# Whatever hook sits in git's own hooks directory and does nothing but run
	# what a manifest registers is run by its entry, and a tool that chains to
	# that directory afterwards (mockspace's gate) must be able to tell. It is
	# not always what `migrate_existing` looked at, which reads the directory
	# `core.hooksPath` named before.
	for ev in $all_events; do
		h="$sd/../hooks/$ev"
		[ -f "$h" ] && [ ! -f "$sd/declined/$ev" ] || continue
		declares_this_hook "$root" "$manifests" "$ev" "$h" || continue
		note_declined "$sd" "$ev" "$h"
	done

	# A hook kept by an earlier install that runs what a manifest registered
	# now declares would run it twice beside that entry. An install with
	# `--only` keeps it, because the manifest that declares it was not being
	# registered; a later one that does register that manifest drops it.
	for ev in $all_events; do
		[ -f "$sd/kept/$ev" ] && [ -f "$sd/entries/$ev/00-existing" ] || continue
		if declares_this_hook "$root" "$manifests" "$ev" "$sd/kept/$ev"; then
			note_declined "$sd" "$ev" "$sd/kept/$ev"
			rm -f "$sd/kept/$ev" "$sd/entries/$ev/00-existing"
			printf 'dropped the kept %s hook, which runs what a manifest registers now\n' "$ev"
		fi
	done

	# A hook left in place because a manifest registered what it does is run by
	# nothing once that manifest drops the event. A full install sees every
	# manifest, so it can tell, and keeps the hook as an entry again while the
	# file is still there unchanged.
	if [ -z "$only" ]; then
		for d in "$sd"/declined/*; do
			[ -f "$d" ] || continue
			ev=${d##*/}
			declares_this_hook "$root" "$manifests" "$ev" "$sd/declined/$ev" && continue
			src=$(cat "$sd/from/$ev" 2>/dev/null) || src="$sd/../hooks/$ev"
			# the copy is never the file a manifest names, so a manifest naming
			# the original itself is asked about the original
			cmp -s "$sd/declined/$ev" "$src" &&
				declares_this_hook "$root" "$manifests" "$ev" "$src" && continue
			if cmp -s "$sd/declined/$ev" "$src"; then
				keep_existing "$sd" "$ev" "$sd/declined/$ev"
				printf 'kept the %s hook again, which no manifest registers now, as 00-existing\n' "$ev"
			fi
			rm -f "$sd/declined/$ev"
		done
	fi

	for ev in $all_events; do
		mkdir -p "$sd/entries/$ev"
		dispatcher_text >"$sd/hooks/$ev"
		chmod +x "$sd/hooks/$ev"
	done

	# An entry a manifest no longer declares stops running on the next install,
	# so a hook taken out of a manifest is not left behind in the registry.
	# Only the names a manifest answers to are cleared; `00-existing` and any
	# entry somebody placed by hand are not, once a record of the names exists.
	# Before one does, an entry no manifest answers to cannot be told from the
	# leavings of an older install, so the first install clears it and says so.
	# A manifest that is gone entirely is cleared by the names recorded at the
	# last install, since nothing current answers to its name any more.
	current=""
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		name=$(manifest_name "$root" "$m")
		check_name "$m" "$name"
		current="$current $name"
		for f in "$sd"/entries/*/"$name"; do
			[ -f "$f" ] && rm -f "$f" "$sd/conditions/${f#"$sd/entries/"}"
		done
	done <<EOF
$manifests
EOF
	if [ -f "$sd/names" ] && [ -z "$only" ]; then
		while IFS= read -r old; do
			[ -n "$old" ] || continue
			case " $current " in *" $old "*) continue ;; esac
			for f in "$sd"/entries/*/"$old"; do
				[ -f "$f" ] || continue
				rm -f "$f" "$sd/conditions/${f#"$sd/entries/"}"
				printf 'removed the %s entry of %s, which no manifest answers to\n' "$old" "${f%/*}"
			done
		done <"$sd/names"
	elif [ ! -f "$sd/names" ] && [ -z "$only" ]; then
		# An install by a git-shook that kept no record of the names. What it
		# registered is every entry here but `00-existing`, so those no
		# manifest answers to now are its leavings, and saying so is the
		# difference between a pruned entry and one that keeps running.
		for f in "$sd"/entries/*/*; do
			[ -f "$f" ] || continue
			old=${f##*/}
			[ "$old" = 00-existing ] && continue
			case " $current " in *" $old "*) continue ;; esac
			rm -f "$f" "$sd/conditions/${f#"$sd/entries/"}"
			printf 'removed the %s entry of %s, which no manifest answers to\n' "$old" "${f%/*}"
		done
	fi
	# Under `--only` the names already recorded stay, since the manifests that
	# own them were not looked at.
	if [ -n "$only" ]; then
		# With no record yet, the entries already here are what an older install
		# registered, and recording only the named one would leave the rest
		# unrecorded for good: a later full install prunes by the record.
		if [ ! -f "$sd/names" ]; then
			for f in "$sd"/entries/*/*; do
				[ -f "$f" ] || continue
				name=${f##*/}
				[ "$name" = 00-existing ] && continue
				grep -qx -- "$name" "$sd/names" 2>/dev/null || printf '%s\n' "$name" >>"$sd/names"
			done
		fi
		for name in $current; do
			grep -qx -- "$name" "$sd/names" 2>/dev/null || printf '%s\n' "$name" >>"$sd/names"
		done
	else
		: >"$sd/names"
		for name in $current; do printf '%s\n' "$name" >>"$sd/names"; done
	fi

	while IFS= read -r m; do
		[ -n "$m" ] || continue
		name=$(manifest_name "$root" "$m")
		check_name "$m" "$name"
		wd=$(manifest_dir "$m")
		for ev in $(manifest_read events "$(mf "$root" "$m")"); do
			shadowed "$ev" "$name" "$m" && continue
			{
				printf '%s\n' "$wd"
				manifest_read argv "$(mf "$root" "$m")" "$ev"
			} >"$sd/entries/$ev/$name"
			# The globs sit beside the entry under the same name, and their
			# presence is what makes the dispatcher select by them.
			globs=$(manifest_read paths "$(mf "$root" "$m")" "$ev")
			if [ -n "$globs" ]; then
				mkdir -p "$sd/conditions/$ev"
				printf '%s\n' "$globs" >"$sd/conditions/$ev/$name"
			fi
		done
	done <<EOF
$manifests
EOF
	record_answers "$sd" "$all_events"

	# The base the dispatchers hand their chains to, copied in beside them so a
	# hook needs nothing on PATH at commit time, the same as the dispatcher.
	cp "$base_src" "$sd/shook"
	chmod +x "$sd/shook"

	# Absolute, because the git directory is not always under the working tree:
	# a linked worktree's `.git` is a file, a submodule's is elsewhere entirely,
	# and git resolves a relative `core.hooksPath` against the working tree's
	# top level. One shape for every case, and `git shook doctor` catches the one
	# thing an absolute path costs, which is a clone that has since moved.
	git -C "$root" config core.hooksPath "$sd/hooks"

	# An older git-shook generated at the repository root. Nothing reads it now
	# and leaving it would put an untracked directory in everybody's status.
	#
	# Unless git tracks it, in which case deleting it is not tidying up, it is
	# a dirty tree that comes back on the next checkout and goes away again on
	# the next install, forever. Somebody committed those files on purpose and
	# this tool is not the one to decide they were wrong.
	if [ -d "$root/.shook" ]; then
		if [ -n "$(git -C "$root" ls-files -- .shook)" ]; then
			printf 'the .shook at the repository root is tracked, so it stays.\n'
			printf 'Nothing reads it any more; remove it from the repository when you are ready.\n'
		else
			rm -rf "$root/.shook"
			printf 'removed the old .shook at the repository root; it is in the git directory now\n'
		fi
	fi

	printf 'Registered. core.hooksPath is %s/hooks.\n' "$sd"
	printf 'It is in the git directory, so it is not committed and nobody has to ignore it,\n'
	printf 'and neither is the config line, so everyone who clones this runs `git shook install`.\n'
}

# Whether the hook already at an event does nothing but run what a manifest
# declares at that same event.
#
# Keeping such a file registers the command twice, as `00-existing` and again
# from the manifest, so a tool that installed its own entrypoint and then
# declared it here runs twice per event and neither half of that is wrong on
# its own. `migrate_existing` already refuses to wrap this tool's own
# dispatcher for exactly that reason; a declared tool's entrypoint is the same
# case one tool over.
#
# The shape it recognises is the shape a generated entrypoint has and nothing
# else: a single command line that is the declared command, optionally `exec`ed
# and optionally handed git's own arguments, with a shebang and comments around
# it. One line of somebody's own beside it makes the file theirs and it is
# kept, since dropping it would lose work no tool wrote and none can give back.
#
# An argument carrying whitespace is not matched either. The manifest holds it
# as one argument and a hook has to quote it, so the two spellings differ and
# there is no reading of the file that says which quoting produced it. Keeping
# it is the safe way to be wrong.
#
# The comparison is over the argument list and not over where it runs, so a
# manifest in a subdirectory declaring a relative command matches a hook at the
# root that runs a different program of the same name. Narrow, since a hook
# written by a tool names an absolute path, and worth knowing before somebody
# widens what counts as a match.
declares_this_hook() { # <root> <manifests> <event> <hook file>
	while IFS= read -r _m; do
		[ -n "$_m" ] || continue
		# a tracked manifest a clone-local one has replaced registers nothing, so
		# a hook running what it declares is not covered by it
		shadowed "$3" "$(manifest_name "$1" "$_m")" "$_m" && continue
		_argv=$(manifest_read argv "$(mf "$1" "$_m")" "$3")
		[ -n "$_argv" ] || continue
		printf '%s\n' "$_argv" | grep -q '[[:space:]]' && continue
		same_file "$1/$(manifest_dir "$_m")" "$_argv" "$4" && return 0
		_cmd=$(printf '%s\n' "$_argv" | tr '\n' ' ')
		_cmd=${_cmd% }
		awk -v want="$_cmd" '
			{
				line = $0
				sub(/^[ \t]+/, "", line)
				sub(/[ \t]+$/, "", line)
				if (line == "" || line ~ /^#/) next
				n++
				sub(/^exec[ \t]+/, "", line)
				sub(/[ \t]+"\$@"$/, "", line)
				sub(/[ \t]+\$@$/, "", line)
				only = line
			}
			END { exit((n == 1 && only == want) ? 0 : 1) }
		' "$4" && return 0
	done <<EOF
$2
EOF
	return 1
}

# Whether a declared argument list is the hook file itself and nothing else: a
# repository whose `core.hooksPath` is a tracked directory, which then declares
# each of those files as its entry, names in the manifest the very file this
# install would keep. Kept as well, it would run twice, so it counts as declared.
# The command resolves against the directory the manifest's hooks run in, and
# both sides are compared as real paths, so a symlink or a `./` is the same file.
same_file() { # <run dir> <argv, one per line> <hook file>
	case $2 in *"
"*) return 1 ;; esac
	case $2 in
	/*) _sf=$2 ;;
	*) _sf=${1%/}/$2 ;;
	esac
	[ -f "$_sf" ] && [ -f "$3" ] || return 1
	_a=$(cd "$(dirname "$_sf")" 2>/dev/null && pwd -P)/$(basename "$_sf") || return 1
	_b=$(cd "$(dirname "$3")" 2>/dev/null && pwd -P)/$(basename "$3") || return 1
	[ "$_a" = "$_b" ]
}

# Where a hook was taken from. It is `core.hooksPath`'s old directory as often
# as `.git/hooks`, and a later install that wants to know whether the hook is
# still there has to look in the place it was.
note_source() { # <shook dir> <event> <hook file>
	mkdir -p "$1/from"
	printf '%s\n' "$3" >"$1/from/$2"
}

# Remember a hook this tool declined to run itself because a manifest registers
# what it does. The original file stays where it was, and a tool that chains to
# the repository's own `.git/hooks/<event>` after its own checks, as
# mockspace's gate does, would run it a second time beside the registered
# entry. The copy is what lets that tool recognise the file as already run:
# `<git-dir>/shook/declined/<event>` equal to the file means skip it, and a
# file someone has since changed is a different hook and is chained to.
note_declined() { # <shook dir> <event> <hook file>
	mkdir -p "$1/declined"
	cp "$3" "$1/declined/$2"
}

# Keep a hook as the first entry of its event: a copy under `kept/`, which
# `uninstall` puts back, and an entry that runs it.
keep_existing() { # <shook dir> <event> <hook file>
	mkdir -p "$1/entries/$2" "$1/kept"
	cp "$3" "$1/kept/$2"
	chmod +x "$1/kept/$2"
	{
		printf '\n'
		# Run it directly rather than through `sh`. It carries its own
		# shebang and it is as likely to be python or perl as shell, in
		# which case `sh` turns a hook that worked into a syntax error
		# while the tool reports it was kept.
		#
		# Absolute, for the same reason `core.hooksPath` is: the git
		# directory is not reliably under the working tree, so a path
		# relative to either is wrong somewhere.
		printf '%s\n' "$1/kept/$2"
	} >"$1/entries/$2/00-existing"
}

# The directory git read hooks from before this install: the old
# `core.hooksPath`, or git's own when there was none. Empty when that was this
# tool's dispatcher, which holds nothing to adopt.
old_hooks_dir() { # <root>
	_sd=$(shook_dir "$1")
	_old=$(git -C "$1" config --get core.hooksPath || true)
	case $_old in
	"$_sd/hooks" | .shook/hooks) return 0 ;;
	# An absolute hooksPath is already a path and must not be joined to the
	# root, which would produce `/repo//etc/git/hooks`.
	/*) printf '%s\n' "$_old" ;;
	"")
		# `.git` is a file rather than a directory in a linked worktree and
		# in a submodule, so the hooks directory is not `$root/.git/hooks`
		# there. Ask git where it is instead of assuming.
		_from=$(git -C "$1" rev-parse --git-path hooks 2>/dev/null) || _from="$1/.git/hooks"
		case $_from in
		/*) ;;
		*) _from="$1/$_from" ;;
		esac
		printf '%s\n' "$_from"
		;;
	*) printf '%s\n' "$1/$_old" ;;
	esac
}

# Where a kept hook for `<event>` goes back to: the directory recorded when it
# was taken, else git's own hooks directory.
old_hooks_dir_recorded() { # <root> <shook dir> <event>
	if [ -f "$2/from/$3" ]; then
		_src=$(cat "$2/from/$3")
		dirname "$_src"
		return 0
	fi
	_c=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) || _c="$1/.git"
	case $_c in /*) ;; *) _c="$1/$_c" ;; esac
	printf '%s\n' "$_c/hooks"
}

# An existing hook at an event we are about to take is moved to
# `<git-dir>/shook/entries/<event>/00-existing` so it still runs, first, and
# uninstall can put it back where it was.
migrate_existing() { # <root> <events> <manifests>
	sd=$(shook_dir "$1")
	old=$(git -C "$1" config --get core.hooksPath || true)
	[ "$old" = "$sd/hooks" ] && return 0
	# The path an older git-shook used. Its dispatcher is ours, so migrating
	# from it would wrap this tool's own generated file as somebody's kept hook
	# and run every entry twice. What does have to come across is the kept
	# directory beside it: those are the hooks this tool took custody of the
	# first time and promised `uninstall` would give back, and `install`
	# removes the directory holding them a few lines later.
	if [ "$old" = ".shook/hooks" ]; then
		migrate_legacy_kept "$1"
		return 0
	fi
	[ -n "$old" ] && [ ! -f "$sd/oldpath" ] && { mkdir -p "$sd"; printf '%s\n' "$old" >"$sd/oldpath"; }

	from=$(old_hooks_dir "$1")

	for ev in $2; do
		h="$from/$ev"
		[ -f "$h" ] || continue
		if declares_this_hook "$1" "$3" "$ev" "$h"; then
			note_declined "$sd" "$ev" "$h"
			note_source "$sd" "$ev" "$h"
			printf 'the %s hook already here runs what a manifest declares, so it is registered once rather than kept as well\n' "$ev"
			continue
		fi
		keep_existing "$sd" "$ev" "$h"
		note_source "$sd" "$ev" "$h"
		printf 'kept the %s hook that was already here, as 00-existing\n' "$ev"
	done
}

# The hooks an older git-shook kept, at `<root>/.shook/kept/<event>`, moved
# into the git directory beside everything else.
#
# Every file there, rather than only the events being registered now: a
# manifest that has since dropped an event still leaves that hook in the kept
# directory, `uninstall` restores whatever it finds there without asking which
# events are live, and `install` is about to delete the directory. Filtering by
# the current event set would lose exactly the hook nobody is thinking about.
migrate_legacy_kept() { # <root>
	sd=$(shook_dir "$1")
	[ -d "$1/.shook/kept" ] || return 0
	for k in "$1"/.shook/kept/*; do
		[ -f "$k" ] || continue
		ev=${k##*/}
		mkdir -p "$sd/entries/$ev" "$sd/kept"
		cp "$k" "$sd/kept/$ev"
		chmod +x "$sd/kept/$ev"
		# The same two lines `migrate_existing` writes: an empty working
		# directory, then the command, run directly so it keeps its own
		# shebang.
		printf '\n%s\n' "$sd/kept/$ev" >"$sd/entries/$ev/00-existing"
		printf 'moved the %s hook the older layout was keeping\n' "$ev"
	done
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

cmd_list() {
	root=$(repo_root)
	sd=$(shook_dir "$root")
	d="$sd/entries"
	if [ ! -d "$d" ]; then
		printf 'nothing registered\n'
		return 0
	fi
	for ev in "$d"/*; do
		[ -d "$ev" ] || continue
		printf '%s\n' "${ev##*/}"
		for e in "$ev"/*; do
			[ -f "$e" ] || continue
			wd=$(head -n 1 "$e")
			printf '  %-16s %s' "${e##*/}" "$(show_argv "$(tail -n +2 "$e")")"
			[ -n "$wd" ] && printf ' (in %s)' "$wd"
			c="$sd/conditions/${ev##*/}/${e##*/}"
			[ -f "$c" ] && printf ' (for %s)' "$(paste -sd ' ' - <"$c")"
			printf '\n'
		done
	done
	active=$(git -C "$root" config --get core.hooksPath || printf '(unset)')
	printf '\ncore.hooksPath: %s\n' "$active"
	[ "$active" = "$sd/hooks" ] || printf 'not active here: run `git shook install`\n'
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
	# `--only` checks the named manifests and leaves every other one alone, as
	# `install --only` registers them: a tool checks its own registration this
	# way without failing on a manifest it has nothing to do with.
	only=""
	while [ $# -gt 0 ]; do
		case $1 in
		--only)
			[ $# -ge 2 ] || die "--only takes a manifest name"
			check_name "--only" "$2"
			only="$only $2"
			shift
			;;
		*) die "unknown flag: $1" ;;
		esac
		shift
	done
	root=$(repo_root)
	sd=$(shook_dir "$root")
	bad=0

	active=$(git -C "$root" config --get core.hooksPath || printf '')
	if [ "$active" != "$sd/hooks" ]; then
		printf 'core.hooksPath is "%s", so nothing here runs. Run `git shook install`.\n' "$active"
		# The one thing an absolute hooksPath costs. Worth saying which of the
		# two it is, because "run install" reads as a fresh setup rather than
		# as a repair somebody already did once.
		case $active in
		/*)
			[ -d "$active" ] ||
				printf 'It points at a directory that is not there, so this clone has moved.\n'
			;;
		esac
		bad=1
	fi

	declared=""
	manifests=$(find_manifests "$root")
	# A clone-local manifest replaces a tracked one of its name whole, so what
	# the tracked one declares is not owed an entry.
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		case $m in /*) LOCALS="$LOCALS none/$(manifest_name "$root" "$m")" ;; esac
	done <<EOF
$manifests
EOF
	found=""
	while IFS= read -r m; do
		[ -n "$m" ] || continue
		name=$(manifest_name "$root" "$m")
		if [ -n "$only" ]; then
			case " $only " in *" $name "*) found="$found $name" ;; *) continue ;; esac
		fi
		for ev in $(manifest_read events "$(mf "$root" "$m")"); do
			shadowed "$ev" "$name" "$m" && continue
			declared="$declared $ev/$name "
			if [ ! -f "$sd/entries/$ev/$name" ]; then
				printf '%s declares [hooks.%s] and is not registered. Run `git shook install`.\n' "$m" "$ev"
				bad=1
				continue
			fi
			# What is registered is what the manifest declares now, so an entry
			# edited by hand, or left from before the manifest changed, is named.
			want=$({
				manifest_dir "$m"
				printf '\n'
				manifest_read argv "$(mf "$root" "$m")" "$ev"
			})
			globs=$(manifest_read paths "$(mf "$root" "$m")" "$ev")
			have_globs=$(cat "$sd/conditions/$ev/$name" 2>/dev/null)
			if [ "$want" != "$(cat "$sd/entries/$ev/$name")" ] || [ "$globs" != "$have_globs" ]; then
				printf 'the %s entry of %s differs from what %s declares. Run `git shook install`.\n' "$ev" "$name" "$m"
				bad=1
			fi
		done
	done <<EOF
$manifests
EOF
	for n in $only; do
		case " $found " in *" $n "*) ;; *)
			printf 'no manifest answers to %s, so nothing of it is registered.\n' "$n"
			bad=1
			;;
		esac
	done

	if [ -d "$sd/entries" ]; then
		for ev in "$sd"/entries/*; do
			[ -d "$ev" ] || continue
			# under `--only`, the events the named manifests declare and no other
			if [ -n "$only" ]; then
				case "$declared" in *" ${ev##*/}/"*) ;; *) continue ;; esac
			fi
			# An entry nothing declares runs on every commit and was left by a
			# manifest that has gone: `--only` installs never prune, so this is
			# the only place it shows.
			for f in "$ev"/*; do
				[ -f "$f" ] || continue
				n=${f##*/}
				[ "$n" = 00-existing ] && continue
				if [ -n "$only" ]; then
					case " $only " in *" $n "*) ;; *) continue ;; esac
				fi
				# only what the last install recorded: an entry placed by hand is the
				# operator's and a full install leaves it alone
				grep -qx -- "$n" "$sd/names" 2>/dev/null || continue
				case "$declared" in *" ${ev##*/}/$n "*) continue ;; esac
				printf 'the %s entry of %s is declared by no manifest. Run `git shook install` without --only to remove it.\n' "$n" "${ev##*/}"
				bad=1
			done
			e="$sd/hooks/${ev##*/}"
			if [ ! -x "$e" ]; then
				printf 'entries exist for %s with no dispatcher. Run `git shook install`.\n' "${ev##*/}"
				bad=1
			elif ! dispatcher_text | cmp -s - "$e"; then
				# An older git-shook's dispatcher keeps running what it was
				# written to run, which is not what this one would.
				printf 'the %s dispatcher was written by another git-shook than this one. Run `git shook install`.\n' "${ev##*/}"
				bad=1
			fi
		done
		# Every dispatcher hands its chain to the base beside it, so one that is
		# gone or another than the one beside this front fails or differs.
		base_src=$(find_base)
		if [ ! -x "$sd/shook" ]; then
			printf 'the base the dispatchers run on is missing at %s. Run `git shook install`.\n' "$sd/shook"
			bad=1
		elif [ -n "$base_src" ] && ! cmp -s "$base_src" "$sd/shook"; then
			printf 'the base at %s differs from %s. Run `git shook install`.\n' "$sd/shook" "$base_src"
			bad=1
		fi
	fi

	# git runs `core.fsmonitor` on every command that reads the index, so one
	# naming a dispatcher that is gone fails them all.
	fm=$(git -C "$root" config core.fsmonitor 2>/dev/null) || fm=""
	case $fm in
	"$sd/hooks/"* | .git/shook/hooks/*)
		case $fm in /*) ;; *) fm="$root/$fm" ;; esac
		if [ ! -x "$fm" ]; then
			printf 'core.fsmonitor names %s, which is not there. Run `git shook install`, or unset it.\n' "$fm"
			bad=1
		fi
		;;
	esac

	# An older git-shook generated at the repository root, where it showed up in
	# everybody's `git status` and had to be ignored by hand. Install clears it,
	# unless somebody committed it, in which case only they can.
	if [ -d "$root/.shook" ]; then
		if [ -n "$(git -C "$root" ls-files -- .shook)" ]; then
			printf 'a .shook directory is tracked at the repository root. Nothing reads it; `git rm -r .shook`.\n'
		else
			printf 'a .shook directory is still at the repository root. Run `git shook install` to clear it.\n'
		fi
		bad=1
	fi

	[ "$bad" -eq 0 ] && printf 'all good\n'
	return $bad
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------

cmd_uninstall() {
	root=$(repo_root)
	sd=$(shook_dir "$root")
	if [ -d "$sd/kept" ]; then
		for k in "$sd"/kept/*; do
			[ -f "$k" ] || continue
			# Back to the directory it was taken from, which is the old
			# `core.hooksPath` as often as git's own: asking git now would answer
			# with this tool's dispatcher directory, which is removed below.
			ev=${k##*/}
			hd=$(old_hooks_dir_recorded "$root" "$sd" "$ev")
			mkdir -p "$hd"
			cp "$k" "$hd/$ev"
			chmod +x "$hd/$ev"
			printf 'put back the %s hook that was here before\n' "$ev"
		done
	fi
	# And the key goes back to whoever held it, if anybody did.
	if [ -f "$sd/oldpath" ]; then
		git -C "$root" config core.hooksPath "$(cat "$sd/oldpath")"
	else
		git -C "$root" config --unset core.hooksPath 2>/dev/null || true
	fi
	# A `core.fsmonitor` pointing at the dispatcher would name a file removed
	# below, and git would fail every command that reads the index.
	fm=$(git -C "$root" config core.fsmonitor 2>/dev/null) || fm=""
	case $fm in
	"$sd/hooks/"* | .git/shook/hooks/*)
		if git -C "$root" config --local --unset core.fsmonitor 2>/dev/null; then
			printf 'unset core.fsmonitor, which named the dispatcher\n'
		else
			printf 'core.fsmonitor names the dispatcher outside this repository'"'"'s config; unset it there\n'
		fi
		;;
	esac
	# The manifests a clone keeps in `manifests/` are declarations and not
	# registry, and are whatever the operator or a tool put there, so they stay
	# and the next `install` picks them up again.
	rm -rf "$sd/hooks" "$sd/entries" "$sd/conditions" "$sd/shook" "$sd/kept" "$sd/declined" "$sd/from" "$sd/oldpath" "$sd/names" "$sd/answers"
	rmdir "$sd" 2>/dev/null || true
	# And whatever an older git-shook left at the repository root, on the same
	# terms `install` uses: a tracked one is somebody's committed file and not
	# this tool's to delete.
	if [ -d "$root/.shook" ] && [ -z "$(git -C "$root" ls-files -- .shook)" ]; then
		rm -rf "$root/.shook"
	fi
	printf 'removed the registry in %s and put core.hooksPath back\n' "$sd"
}

# ---------------------------------------------------------------------------

usage() {
	cat <<'HELPTEXT'
git-shook: hooks that shook on it.

Git runs one program per hook event, so a tool that installs a hook replaces
whatever was there. git-shook puts one dispatcher at the event and gives every
tool a place to register beside the others.

USAGE
    git shook <command>

COMMANDS
    install [--yes] [--only <name>]
                      Read every tracked shook.toml, show what each would run,
                      and register it once you say so. --only registers the
                      manifests of that name and leaves the others as they
                      were, which is what a tool registering its own wants.
    list              What is registered, per event, in the order it runs.
    doctor [--only <name>]
                      Whether what is declared and what is registered agree,
                      entry by entry. --only checks the manifests of that name
                      and no other, which is what a tool checking its own wants.
    uninstall         Remove the registry and put back the hook that was here.
    version           Print the version.

A shook.toml declares what its own project wants run:

    name = "ante"

    [hooks.pre-commit]
    run = ["ante", "fix"]

`run` is an argument list rather than a command line, so nothing goes through a
shell and there is no quoting to get wrong. It runs with the manifest's own
directory as its working directory. A hook that needs a pipe or a redirect ships
a script and names it, which puts it in a diff where somebody can object to it.

At fsmonitor-watchman stdout is the reply to git, so one entry says
`answers = true` in its section and the others run with their output discarded.
With none, a hook that was already there answers, else every path is reported
changed. Stdin reaches entries only at the events git feeds it to.

An entry with `paths = ["*.md"]` runs only where the event touched a path a
glob matches: what is staged at pre-commit and commit-msg, what a pushed tip
adds at pre-push. An argument that is exactly {paths} becomes those paths.

The entries of an event run on shook, the chain runner that ships beside this
script; install copies it in beside the dispatchers.

Discovery happens when you run `install`, never when a hook fires, so a manifest
arriving through a merge does nothing until you look at it and say yes.

A declaration only this clone has goes in <git-dir>/shook/manifests/<name>.toml,
in the same format. install reads it beside the tracked ones, it runs from the
repository root, and it replaces a tracked manifest of the same name as a whole.
HELPTEXT
}

case "${1:-}" in
install)
	shift
	cmd_install "$@"
	;;
list)
	shift
	cmd_list "$@"
	;;
doctor)
	shift
	cmd_doctor "$@"
	;;
uninstall)
	shift
	cmd_uninstall "$@"
	;;
dispatcher)
	dispatcher_text
	;;
version | --version | -V)
	printf 'git-shook %s\n' "$VERSION"
	;;
help | --help | -h | "")
	usage
	;;
*)
	die "unknown command: $1 (try \`git shook help\`)"
	;;
esac
