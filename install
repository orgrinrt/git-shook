#
# Put git-shook, the shook base it runs on, its man page, its completions and,
# where cargo is, claude-shook somewhere git and the shell will find them.
#
#   ./install                 into ~/.local
#   ./install /usr/local      somewhere else
#   PREFIX=/opt ./install     the same, by environment
#
# Nothing here needs root unless the prefix does.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
prefix=${1:-${PREFIX:-$HOME/.local}}

bin="$prefix/bin"
man1="$prefix/share/man/man1"
bashcomp="$prefix/share/bash-completion/completions"
zshcomp="$prefix/share/zsh/site-functions"

mkdir -p "$bin" "$man1" "$bashcomp" "$zshcomp"

install_file() { # <source> <destination> <mode>
	cp "$1" "$2"
	chmod "$3" "$2"
	printf '  %s\n' "$2"
}

printf 'installing git-shook into %s\n' "$prefix"
install_file "$here/git-shook" "$bin/git-shook" 755
install_file "$here/shook" "$bin/shook" 755
install_file "$here/man/git-shook.1" "$man1/git-shook.1" 644
install_file "$here/man/shook.1" "$man1/shook.1" 644
install_file "$here/completions/git-shook.bash" "$bashcomp/git-shook" 644
install_file "$here/completions/_git-shook" "$zshcomp/_git-shook" 644

# claude-shook, the Claude Code front, is Rust: built where cargo is, beside the
# base it runs on, and said to be left out where it is not. git-shook needs
# nothing of it.
if command -v cargo >/dev/null 2>&1; then
	if (cd "$here/claude-shook" && cargo install --quiet --locked --path . --root "$prefix"); then
		printf '  %s\n' "$bin/claude-shook"
	else
		printf 'claude-shook did not build, so the Claude Code front is not installed; git-shook is\n'
	fi
else
	printf 'cargo is not on PATH, so claude-shook, the Claude Code front, is not installed; git-shook is\n'
fi

printf '\n'
case ":$PATH:" in
*":$bin:"*) ;;
*) printf '%s is not on your PATH, so `git shook` will not resolve yet.\n' "$bin" ;;
esac

printf 'Try `git shook help`, and `git help shook` for the man page.\n'
